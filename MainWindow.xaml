<Window x:Class="EdgeTime.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="261" Height="285" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#F6FAFD" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" UseLayoutRounding="True">
<Window.Resources><Style x:Key="TimerAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#28FFFFFF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#3AFFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="Background" Value="#3AFFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Background" Value="#48FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
<Grid><Border x:Name="ShellBorder" CornerRadius="16" BorderThickness="0" ClipToBounds="True" Background="{StaticResource GlassTint}">
 <Grid><Grid x:Name="ContentLayer" Margin="14,10,14,10" Background="Transparent" MouseLeftButtonDown="DragHeader">
 <Grid>
  <Grid x:Name="TimerPage"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="70"/><RowDefinition Height="38"/><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock x:Name="TimerTitle" Text="番茄钟" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
    <RepeatButton x:Name="MinusA" Tag="a-" Width="30" Height="30" ToolTip="减少当前时长" AutomationProperties.Name="减少当前时长" Click="Adjust"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M 5,12 L 19,12" Stroke="#F6FAFD" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></RepeatButton>
    <TextBlock x:Name="CountdownText" Grid.Column="1" Text="25:00" FontSize="38" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
    <RepeatButton x:Name="PlusA" Grid.Column="2" Tag="a+" Width="30" Height="30" ToolTip="增加当前时长" AutomationProperties.Name="增加当前时长" Click="Adjust"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M 5,12 L 19,12 M 12,5 L 12,19" Stroke="#F6FAFD" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></RepeatButton>
   </Grid>
   <Border x:Name="ModeArea" Grid.Row="2" Background="#20E3F3FA" CornerRadius="9" Padding="9,0"><DockPanel><TextBlock Text="连续轮换" FontSize="12" VerticalAlignment="Center"/><CheckBox x:Name="Continuous" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ModeChanged" Unchecked="ModeChanged" ToolTip="勾选后两段时长交替提醒"><CheckBox.Template><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="36" Height="21" CornerRadius="11" Background="#59768FA1"><Ellipse x:Name="Thumb" Width="15" Height="15" Fill="#EEF8FC" HorizontalAlignment="Left" Margin="3,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#B990D2ED"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></CheckBox.Template></CheckBox></DockPanel></Border>
   <Grid x:Name="SecondDuration" Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="下一段 · 分钟" FontSize="12" VerticalAlignment="Center" Foreground="#E3F0F6"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <RepeatButton x:Name="MinusB" Tag="b-" Width="28" Height="27" ToolTip="减少下一段时长" AutomationProperties.Name="减少下一段时长" Click="Adjust"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M 5,12 L 19,12" Stroke="#F6FAFD" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></RepeatButton>
    <TextBlock x:Name="MinutesB" Text="5" Width="40" FontSize="14" TextAlignment="Center" VerticalAlignment="Center"/>
    <RepeatButton x:Name="PlusB" Tag="b+" Width="28" Height="27" ToolTip="增加下一段时长" AutomationProperties.Name="增加下一段时长" Click="Adjust"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="M 5,12 L 19,12 M 12,5 L 12,19" Stroke="#F6FAFD" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></RepeatButton>
   </StackPanel></Grid>
   <Grid Grid.Row="4" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="开始" Height="33" FontWeight="SemiBold" Style="{StaticResource TimerAction}" Click="ToggleTimer"/><Button Grid.Column="2" Width="36" Height="33" Padding="0" ToolTip="重置" AutomationProperties.Name="重置计时器" Style="{StaticResource TimerAction}" Click="ResetTimer"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M 19,9 A 7,7 0 1 0 19,15 M 19,4 L 19,9 L 14,9" Stroke="#F6FAFD" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button></Grid>
  </Grid>
  <Grid x:Name="CalendarPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="29"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock x:Name="FullTime" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Grid Grid.Row="1"><TextBlock x:Name="MonthTitle" FontSize="13" FontWeight="Bold" Foreground="#EDF9FF" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button ToolTip="上个月" AutomationProperties.Name="上个月" Width="27" Height="27" Padding="0" Click="PreviousMonth"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M 15,5 L 8,12 L 15,19" Stroke="#F6FAFD" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
   <Button ToolTip="下个月" AutomationProperties.Name="下个月" Width="27" Height="27" Padding="0" Margin="5,0,0,0" Click="NextMonth"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M 9,5 L 16,12 L 9,19" Stroke="#F6FAFD" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
   </StackPanel></Grid>
   <Border Grid.Row="2" Background="#287FAEC9" CornerRadius="6"><UniformGrid x:Name="WeekHeader" Columns="7"/></Border><UniformGrid Grid.Row="3" x:Name="CalendarDays" Columns="7" Rows="6" Margin="0,3,0,0"/>
  </Grid>
 </Grid>
 <Button x:Name="SwitchButton" ToolTip="切换番茄钟与日历" AutomationProperties.Name="切换番茄钟与日历" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="32" Padding="5" Panel.ZIndex="2" Click="SwitchPage"><Viewbox Width="19" Height="19"><Canvas Width="24" Height="24"><Path Data="M 4,8 L 19,8 M 19,8 L 16,5 M 19,8 L 16,11 M 20,16 L 5,16 M 5,16 L 8,13 M 5,16 L 8,19" Stroke="#F6FAFD" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
 </Grid></Grid></Border><Canvas IsHitTestVisible="False" ClipToBounds="True"><Border x:Name="MorphSurface" Background="{StaticResource GlassTint}" CornerRadius="14" Visibility="Collapsed"/></Canvas></Grid></Window>
